# ycode local artifacts
.agents/

# build artifacts
bin/
/sat-pdf-eval
frontend/dist/assets/
frontend/dist/index.html
frontend/node_modules/

# runtime artifacts
*.db
*.db-wal
*.db-shm
omniscore.key

# Sibling content repo + raw PDF source dirs are kept out of the omniscore repo entirely.
# Anchored with leading slash so we don't accidentally ignore tests/data/.
/data/

# Importer scratch dir (rasterized pages, LLM cache, review log).
.import-cache/

# `make start` background-server tracking (pid file + stdout log).
.run/

# Env files. Real secrets must never be committed; .env.example is the template.
.env
.env.local
.env.*.local

# Claude Code config kept private to each machine (not committed to this repo).
.claude/
