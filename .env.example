# OmniScore environment variables. Copy to .env (gitignored) or export in
# your shell. None are required to RUN the omniscore binary; they only
# affect the AP PDF importer (cmd/ap-import).

# --- Vision LLM selection -----------------------------------------------
# Default model spec for `bin/ap-import`, used when -model is not passed.
# Format: vendor/model. Supported vendors: ollama, anthropic, openai, gemini.
# OMNI_MODEL=anthropic/claude-sonnet-4-6
# OMNI_MODEL=ollama/llama3.2-vision:90b
# OMNI_MODEL=openai/gpt-4o
# OMNI_MODEL=gemini/gemini-2.5-pro

# --- Cloud API keys (only the one matching OMNI_MODEL is needed) --------
# Never commit real keys. Get them from each vendor's console.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...        # GOOGLE_API_KEY also accepted as a fallback
